pipeline {
    agent any

    tools {
        nodejs 'NodeJS 16' // Configure in Global Tool Configuration
} 
 stages {
    stage('Checkout') {
       steps {
           git 'https://github.com/sasankasandeepa152-ship-it/Jenkinsfile.git'
        }
    }
    stage('Install') {
          steps {
               bat 'npm install'
          }
    }
    stage('Test') {
          steps {
              bat 'npm test'
         }
    }
    stage('Run') {
          steps {
              bat 'npm start'
         }
    }
  }
}
